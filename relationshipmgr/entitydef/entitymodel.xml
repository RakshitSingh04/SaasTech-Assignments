<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <!-- ========================================================= -->
    <!-- ======================== Defaults ======================= -->
    <!-- ========================================================= -->
    <title>Entity of Relationshipmgr Component</title>
    <description>None</description>
    <copyright></copyright>
    <version></version>

    <entity entity-name="RelPartyType" package-name="org.apache.ofbiz.relationshipmgr" title="Relationship Party Type Entity">
        <field name="partyTypeId" type="id"><description>primary sequenced ID</description></field>
        <field name="description" type="description"></field>
        <prim-key field="partyTypeId"/>
    </entity>

    <entity entity-name="RelParty" package-name="org.apache.ofbiz.relationshipmgr" title="Relationship Party Entity">
        <field name="partyId" type="id"><description>Primary Sequenced ID</description></field>
        <field name="partyTypeId" type="id"></field>
        <field name="firstName" type="name"></field>
        <field name="lastName" type="name"></field>
        <field name="groupName" type="name"></field>
        <prim-key field="partyId"/>
        <relation type="one" fk-name="REL_PTY_TYPE" rel-entity-name="RelPartyType">
            <key-map field-name="partyTypeId"/>
        </relation>
    </entity>

    <entity entity-name="RelContactMechType" package-name="org.apache.ofbiz.relationshipmgr" title="Relationship Contact Mech Type Entity">
        <field name="contactMechTypeId" type="id"><description>primary sequenced ID</description></field>
        <field name="description" type="description"></field>
        <prim-key field="contactMechTypeId"/>
    </entity>

    <entity entity-name="RelContactMech" package-name="org.apache.ofbiz.relationshipmgr" title="Relationship Contact Mech Entity">
        <field name="contactMechId" type="id"><description>Primary Sequenced ID</description></field>
        <field name="contactMechTypeId" type="id"></field>
        <field name="infoString" type="value"></field>
        <prim-key field="contactMechId"/>
        <relation type="one" fk-name="REL_CM_TYPE" rel-entity-name="RelContactMechType">
            <key-map field-name="contactMechTypeId"/>
        </relation>
    </entity>

    <entity entity-name="RelPartyContactMech" package-name="org.apache.ofbiz.relationshipmgr" title="Relationship Party Contact Mech Entity">
        <field name="partyId" type="id"></field>
        <field name="contactMechId" type="id"></field>
        <field name="fromDate" type="date-time"></field>
        <field name="thruDate" type="date-time"></field>
        <prim-key field="partyId"/>
        <prim-key field="contactMechId"/>
        <prim-key field="fromDate"/>
        <relation type="one" fk-name="REL_PCM_PTY" rel-entity-name="RelParty">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="REL_PCM_CM" rel-entity-name="RelContactMech">
            <key-map field-name="contactMechId"/>
        </relation>
    </entity>
</entitymodel>
