<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Relationshipmgr Services</description>
    <vendor></vendor>
    <version>1.0</version>

    <!-- RelParty Services -->
    <service name="createRelParty" default-entity-name="RelParty" engine="entity-auto" invoke="create" auth="true">
        <description>Create a RelParty record</description>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="updateRelParty" default-entity-name="RelParty" engine="entity-auto" invoke="update" auth="true">
        <description>Update a RelParty record</description>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <!-- RelContactMech Services -->
    <service name="createRelContactMech" default-entity-name="RelContactMech" engine="entity-auto" invoke="create" auth="true">
        <description>Create a RelContactMech record</description>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <!-- RelPartyContactMech Services -->
    <service name="createRelPartyContactMech" default-entity-name="RelPartyContactMech" engine="entity-auto" invoke="create" auth="true">
        <description>Create a RelPartyContactMech record</description>
        <auto-attributes include="pk" mode="INOUT" optional="true"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
        <override name="fromDate" optional="true"/> <!-- Auto-populated by entity-auto if omitted -->
    </service>
    
    <service name="createRelContactMechAndLink" engine="groovy"
            location="component://relationshipmgr/groovyScripts/RelationshipmgrServices.groovy" invoke="createRelContactMechAndLink" auth="true">
        <description>Create Contact Mech and Link to Party</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="contactMechTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="infoString" type="String" mode="IN" optional="false"/>
    </service>

</services>
